# Discord
DISCORD_TOKEN=your_bot_token_here
# CLIENT_ID MUST equal the emoji registry applicationId (1381818375633899562, D-16).
# The sanguo emoji set is owned by this application; startup hard-fails on mismatch (D-14).
CLIENT_ID=1381818375633899562

# Database — LOCAL DEV ONLY credentials (tutien:password on localhost).
# These are a throwaway local-dev convention (option chosen: local PostgreSQL 16 install,
# no docker-compose.yml). Production secrets live in /etc/tutien/.env on the server and
# are never committed. Do NOT reuse these credentials anywhere outside local development.

# Database — runtime (via PgBouncer, port 6432)
DATABASE_URL=postgresql://tutien:password@localhost:6432/tutien

# Database — migrations only (direct PostgreSQL, port 5432 — PgBouncer 6432 breaks
# drizzle-kit advisory locks, so migrate/seed always use DATABASE_URL_DIRECT)
DATABASE_URL_DIRECT=postgresql://tutien:password@localhost:5432/tutien

# Redis
REDIS_URL=redis://localhost:6379

# Farming Channels
AUTH_SERVER_ID=your_auth_server_guild_id
FARMING_CATEGORY_ID=your_farming_category_channel_id

# App
NODE_ENV=development
PORT=3000

# RapidAPI 'free-api-live-football-data' API key(s) — comma-separated for key rotation
API_FOOTBALL_KEYS=your_rapidapi_key_here

