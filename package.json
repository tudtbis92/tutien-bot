{
  "name": "tutien-bot",
  "version": "1.0.0",
  "description": "Discord RPG xianxia bot — multi-shard, i18n, TypeScript",
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx --watch src/shard.ts",
    "start": "node dist/bot.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "drizzle-kit migrate",
    "prepare": "husky",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "gen:emojis": "tsx scripts/gen-sanguo-emojis.ts",
    "seed:sanguo": "tsx scripts/seed-sanguo.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --max-warnings=0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genZVN2021/tutien-bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/genZVN2021/tutien-bot/issues"
  },
  "homepage": "https://github.com/genZVN2021/tutien-bot#readme",
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@napi-rs/canvas": "^1.0.5",
    "discord.js": "14.27.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "i18next": "26.3.6",
    "i18next-fs-backend": "2.6.7",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pg-boss": "12.27.0",
    "playwright": "^1.62.1",
    "proxy-agent": "^8.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/pg": "8.21.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-i18next": "6.1.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "pm2": "7.0.3",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
